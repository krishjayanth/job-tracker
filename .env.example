# Copy to .env for local runs. On Render, set these in the service's Environment tab
# (render.yaml lists them). Only GOOGLE_CLIENT_ID/SECRET are needed to try it locally.

# Google OAuth "Web application" client (sign-in + read-only Gmail)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# The site's address; Google redirects back to PUBLIC_URL/oauth2callback
# PUBLIC_URL=https://job-tracker-xxxx.onrender.com

# Sign-in: only these Google accounts get in (comma-separated). Leave unset locally to skip sign-in.
# ALLOWED_EMAIL=you@gmail.com
# SESSION_SECRET=   # random string, 32+ characters

# Storage: Postgres (Neon). Unset = local files in data/
# DATABASE_URL=postgresql://user:pass@host/db?sslmode=require

# Email classifier: GroqCloud. Unset = built-in rules only
# GROQ_API_KEY=
# GROQ_MODEL=openai/gpt-oss-20b

# Secret for the pinger URL: /api/cron/sync?key=CRON_SECRET (16+ characters)
# CRON_SECRET=

PORT=5178
SYNC_INTERVAL_MINUTES=5
INITIAL_SYNC_DAYS=90
GHOST_AFTER_DAYS=21
MAX_EMAILS_PER_SYNC=500
