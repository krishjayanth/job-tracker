# Copy to .env and adjust. All optional.

# Better email classification using Claude (falls back to built-in rules if unset)
# ANTHROPIC_API_KEY=sk-ant-...
# CLAUDE_MODEL=claude-opus-5-5

PORT=5178
SYNC_INTERVAL_MINUTES=5
INITIAL_SYNC_DAYS=90
GHOST_AFTER_DAYS=21
MAX_EMAILS_PER_SYNC=500
# GOOGLE_CREDENTIALS=credentials.json

# Local LLM via Ollama (auto-detected when running). Optional overrides:
# OLLAMA_MODEL=qwen3.5:2b
# OLLAMA_URL=http://localhost:11434
# USE_OLLAMA=0
